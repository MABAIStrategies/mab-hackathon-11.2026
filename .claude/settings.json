{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit(./**)",
      "Bash(pnpm *)",
      "Bash(node *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch*)",
      "Bash(git checkout*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git rebase*)",
      "Bash(git merge*)",
      "Bash(git worktree *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push origin refactor/*)",
      "Bash(gh pr *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main*)",
      "Bash(git push * master)",
      "Bash(git push * master *)",
      "Bash(git push * *:master*)",
      "Bash(gh pr merge*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -fr ..*)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development*)",
      "Read(**/.env.production*)",
      "Read(**/.env.preview*)",
      "Read(**/.env.staging*)",
      "Read(**/.env.test*)",
      "Read(**/.env.vercel*)",
      "Read(**/verizon*)",
      "Read(**/verizon*/**)",
      "Read(**/Verizon*)",
      "Read(**/Verizon*/**)",
      "Edit(**/verizon*)",
      "Edit(**/verizon*/**)",
      "Edit(**/Verizon*)",
      "Edit(**/Verizon*/**)",
      "Read(//**/verizon*)",
      "Read(//**/verizon*/**)",
      "Read(//**/Verizon*)",
      "Read(//**/Verizon*/**)",
      "Edit(//**/verizon*)",
      "Edit(//**/verizon*/**)",
      "Edit(//**/Verizon*)",
      "Edit(//**/Verizon*/**)"
    ]
  }
}
